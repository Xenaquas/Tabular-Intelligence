# Copy to .env and fill in locally. Never commit .env.

OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- AWS Bedrock (config.py) ---
REGION=ap-south-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
# Optional: IAM role to assume via STS (also read as AWS_ROLE_ARN)
ROLE_ARN=
# Optional direct credentials; prefer the standard AWS credential chain / SSO instead
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- Local Nomic embedding server (optional; fuzzy fallback if absent) ---
NOMIC_EMBED_BASE_URL=http://127.0.0.1:8088/v1
NOMIC_EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5-GGUF:Q4_K_M

# --- Reserved settings (not enforced by the active workflow; see TECHNICAL.md) ---
MAX_CATEGORICAL_CARDINALITY=2000
MAX_SQL_RETRY=3

# --- Local Oracle Database (python-oracledb) ---
ORACLE_HOST=127.0.0.1
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=FREEPDB1
ORACLE_USER=TABULA_DEMO_RO
ORACLE_PASSWORD=your_oracle_password_here
ORACLE_SCHEMA=TABULA_DEMO_OWNER
ORACLE_ALLOWED_SCHEMAS=TABULA_DEMO_OWNER
ORACLE_ALLOWED_TABLES=USERS,CLAIMS
ORACLE_MODE=thin
