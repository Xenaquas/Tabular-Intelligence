# Copy to .env and fill in locally. Never commit .env.

# --- AWS Bedrock (config.py) ---
REGION=ap-south-1
MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
# Optional: IAM role to assume via STS (also read as AWS_ROLE_ARN)
ROLE_ARN=
# Optional direct credentials; prefer the standard AWS credential chain / SSO instead
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- Local Nomic embedding server (optional; fuzzy fallback if absent) ---
NOMIC_EMBED_BASE_URL=http://127.0.0.1:8088/v1
NOMIC_EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5-GGUF:Q4_K_M

# --- Reserved settings (not enforced by the active workflow; see TECHNICAL.md) ---
MAX_CATEGORICAL_CARDINALITY=2000
MAX_SQL_RETRY=3
